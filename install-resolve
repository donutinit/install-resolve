#!/usr/bin/env python3
import argparse
import ctypes
import os
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import zipfile
from datetime import datetime
from pathlib import Path

DRY = False
COLOR = False

# ─────────────────────────────── Style / color ────────────────────────────────

def _color_on(mode):
    if mode == "always":
        return True
    if mode == "never" or "NO_COLOR" in os.environ:
        return False
    if os.environ.get("TERM") == "dumb":
        return False
    return sys.stdout.isatty()


class C:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITAL = "\033[3m"
    AMBER = "\033[38;5;214m"
    CYAN = "\033[38;5;51m"
    GREEN = "\033[38;5;42m"
    RED = "\033[38;5;203m"
    YELLOW = "\033[38;5;220m"
    GRAY = "\033[38;5;244m"
    MAG = "\033[38;5;177m"
    WHITE = "\033[38;5;255m"


def paint(text, *codes):
    if not COLOR:
        return text
    return "".join(codes) + text + C.RESET


def banner(search_dirs):
    mode = "Preview" if DRY else "Install"
    locations = ", ".join(str(Path(d).expanduser()) for d in search_dirs)

    print()
    print(paint("╭─ DaVinci Resolve installer", C.BOLD, C.CYAN))
    print(f"│ {paint('Search'.ljust(13), C.DIM)} {locations}")
    print(f"│ {paint('Mode'.ljust(13), C.DIM)} {paint(mode, C.BOLD, C.AMBER if DRY else C.GREEN)}")


def section(title):
    print(paint(f"├─ {title}", C.BOLD, C.MAG))


def step(msg):
    print("│  " + paint("›", C.CYAN) + f" {msg}")


def ok(msg):
    print("│  " + paint("✓", C.GREEN) + f" {msg}")


def info(msg):
    print("│    " + paint(msg, C.DIM, C.GRAY))


def warn(msg):
    sys.stdout.flush()
    print("│  " + paint("!", C.YELLOW) + " " + paint(msg, C.YELLOW), file=sys.stderr)


def die(msg):
    sys.stdout.flush()
    print(paint("╰─ ! ", C.BOLD, C.RED) + paint(msg, C.BOLD, C.RED), file=sys.stderr)
    sys.exit(1)


def success_box(msg):
    print(paint(f"╰─ ✓ {msg}", C.BOLD, C.GREEN))


# ─────────────────────────────── Packages ─────────────────────────────────────

