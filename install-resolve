    ["libaprutil1t64", "libaprutil1"],
    ["libasound2t64", "libasound2"],
    ["libfuse2t64", "libfuse2"],
    ["libglib2.0-0t64", "libglib2.0-0"],
]

APT_FIXED = [
    "libxcb-composite0",
    "libxcb-cursor0",
    "libxcb-damage0",
    "libxcb-xinerama0",
    "libxcb-xinput0",
    "x11-xserver-utils",
    "ocl-icd-opencl-dev",
    "clinfo",
]

DNF_PKGS = [
    "apr",
    "apr-util",
    "alsa-lib",
    "fuse",
    "fuse-libs",
    "glib2",
    "libX11-xcb",
    "libxcrypt-compat",
    "libxcb",
    "libxkbcommon-x11",
    "xcb-util",
    "xcb-util-cursor",
    "xcb-util-image",
    "xcb-util-keysyms",
    "xcb-util-renderutil",
    "xcb-util-wm",
    "xhost",
    "ocl-icd",
    "clinfo",
]

PACMAN_PKGS = [
    "apr-util",
    "alsa-lib",
