    "clinfo",
]

WAYLAND_PKGS = {
    "apt": "xwayland",
    "dnf": "xorg-x11-server-Xwayland",
    "pacman": "xorg-xwayland",
}


def q(x):
    return shlex.quote(str(x))


def sudo():
    if os.geteuid() == 0:
        return []
    if not shutil.which("sudo"):
        die("sudo is required unless this script is run as root.")
    return ["sudo"]


def run(cmd, check=True, env=None, cwd=None):
    print("│    " + paint("$ " + " ".join(q(c) for c in cmd), C.DIM, C.GRAY))
    if DRY:
        return subprocess.CompletedProcess(cmd, 0)
    try:
        return subprocess.run(cmd, check=check, env=env, cwd=cwd)
    except FileNotFoundError:
        die(f"Command not found: {cmd[0]}")
    except subprocess.CalledProcessError as exc:
        die(f"Command failed with exit code {exc.returncode}: {cmd[0]}")


def out(cmd):
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, check=False
        )
    except FileNotFoundError:
        return None


def detect_pm():
    if shutil.which("apt-get"):
        return "apt"
    if shutil.which("dnf"):
        return "dnf"
    if shutil.which("pacman"):
        return "pacman"
    return None


def apt_pkg_available(pkg):
    r = out(["apt-cache", "show", pkg])
    return bool(r and r.returncode == 0 and r.stdout.strip())


def pkg_installed(pm, pkg):
    if pm == "apt":
        r = out(["dpkg-query", "-W", "-f=${Status}", pkg])
        return bool(r and r.returncode == 0 and "install ok installed" in r.stdout)
    if pm == "dnf":
        r = out(["rpm", "-q", pkg])
        return bool(r and r.returncode == 0)
    if pm == "pacman":
        r = out(["pacman", "-Q", pkg])
        return bool(r and r.returncode == 0)
    return False


def resolve_apt_pkgs():
    pkgs = []
    for group in APT_GROUPS:
        chosen = None
        for p in group:
            if apt_pkg_available(p):
                chosen = p
                break
        if chosen:
            pkgs.append(chosen)
        else:
            warn(f"No apt candidate found for: {', '.join(group)}")
    pkgs += [p for p in APT_FIXED if apt_pkg_available(p)]
    return pkgs


def is_wayland_session():
    return (
        os.environ.get("XDG_SESSION_TYPE", "").lower() == "wayland"
        or bool(os.environ.get("WAYLAND_DISPLAY"))
    )


def packages_for(pm):
    if pm == "apt":
        pkgs = resolve_apt_pkgs()
    elif pm == "dnf":
        pkgs = list(DNF_PKGS)
    elif pm == "pacman":
        pkgs = list(PACMAN_PKGS)
    else:
        return []

    if is_wayland_session():
        wayland_pkg = WAYLAND_PKGS[pm]
        if pm != "apt" or apt_pkg_available(wayland_pkg):
            pkgs.append(wayland_pkg)
    return pkgs


def dependency_install_cmd(pm, missing):
    if pm == "apt":
        return sudo() + ["apt-get", "install", "-y", *missing]
    if pm == "dnf":
        return sudo() + ["dnf", "install", "-y", *missing]
    if pm == "pacman":
        return sudo() + ["pacman", "-S", "--needed", "--noconfirm", *missing]
    return []


def confirm(msg):
    prompt = "│  " + paint("?", C.AMBER) + f" {msg} [y/N] "
    try:
        answer = input(prompt)
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer.strip().lower() in {"y", "yes"}


def install_dependencies(pm, missing):
    if DRY:
        step(f"Would install {len(missing)} missing package(s).")
    elif not confirm(f"Install {len(missing)} missing package(s)?"):
        die("Dependency installation cancelled. Use --skip-deps to continue anyway.")
    else:
        step(f"Installing {len(missing)} package(s).")

    run(dependency_install_cmd(pm, missing))
    ok("Dependency installation previewed." if DRY else "Dependencies installed.")


def report_deps():
    section("Dependencies")
    pm = detect_pm()
    if not pm:
        warn("Unsupported package manager; dependency checks were skipped.")
        return

    info(f"Package manager: {paint(pm, C.BOLD, C.CYAN)}")

    pkgs = packages_for(pm)

    missing = [p for p in pkgs if not pkg_installed(pm, p)]

    for p in pkgs:
        if p in missing:
            print("│  " + paint("✗", C.RED) + f" {p}" + paint("  (missing)", C.DIM, C.RED))
        else:
            print("│  " + paint("✓", C.GREEN) + " " + paint(p, C.GRAY))

    if not missing:
        ok("All dependencies are installed.")
        return

    warn(f"{len(missing)} required package(s) are missing.")
    install_dependencies(pm, missing)


def is_resolve(name):
    name = name.lower()
    return "davinci" in name and "resolve" in name


def product_name(name):
    if "studio" in name.lower():
        return "DaVinci Resolve Studio"
    return "DaVinci Resolve"


def is_extract_name(name):
    n = name.lower()
    return "davinci-resolve" in n and "-extract-" in n


def is_extract_path(p):
    return any(is_extract_name(part) for part in Path(p).parts)


def build_candidates(search_dirs):
    hits = []
    for d in search_dirs:
        d = Path(d).expanduser().resolve()
        if not d.exists():
            continue
        for p in d.rglob("*"):
            if is_extract_path(p):
                continue
            if not p.is_file():
                continue
            if is_resolve(p.name) and p.suffix.lower() in (".zip", ".run"):
                hits.append(p)
    return sorted(hits, key=lambda p: p.stat().st_mtime, reverse=True)


def find_latest_build(search_dirs):
    section("Finding installer")
    hits = build_candidates(search_dirs)
    if not hits:
        locations = ", ".join(str(Path(d).expanduser()) for d in search_dirs)
        die(f"No DaVinci Resolve .zip/.run file found in: {locations}")
    if len(hits) > 1:
        info(f"Found {len(hits)} builds; using the newest one.")
    ok(f"Build: {paint(hits[0].name, C.BOLD, C.WHITE)}")
    info(f"Edition: {product_name(hits[0].name)}")
    info(f"Source: {hits[0].parent}")
    return hits[0]


EXTRACT_PREFIX = ".davinci-resolve-extract-"


def extract_zip(zip_path):
    try:
        archive = zipfile.ZipFile(zip_path)
    except zipfile.BadZipFile:
        die(f"Not a valid ZIP file: {zip_path.name}")

    with archive:
        members = [
            item for item in archive.infolist()
            if not item.is_dir()
            and Path(item.filename).suffix.lower() == ".run"
            and is_resolve(Path(item.filename).name)
        ]

        if not members:
            die("The ZIP does not contain a DaVinci Resolve .run installer.")

        member = sorted(members, key=lambda item: item.date_time, reverse=True)[0]

        if DRY:
            step(f"Would extract: {Path(member.filename).name}")
            return zip_path.parent / EXTRACT_PREFIX / member.filename

        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        target = Path(tempfile.mkdtemp(
            prefix=f"{EXTRACT_PREFIX}{stamp}-",
            dir=str(zip_path.parent)
        ))

        step(f"Extracting ZIP into: {target.name}")
        archive.extractall(target)

    runs = [p for p in target.rglob("*.run") if is_resolve(p.name)]

    runfile = sorted(runs, key=lambda p: p.stat().st_mtime, reverse=True)[0]
    runfile.chmod(runfile.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

    ok(f"Installer extracted: {runfile.name}")
    return runfile


def get_runfile(build):
    if build.suffix.lower() == ".zip":
        return extract_zip(build)

    if not DRY:
        build.chmod(build.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    return build


def fuse2_ready():
    fuse_device = Path("/dev/fuse")
    if not fuse_device.exists() or not os.access(fuse_device, os.R_OK | os.W_OK):
        return False
    if not shutil.which("fusermount") and not shutil.which("fusermount3"):
        return False
    try:
        ctypes.CDLL("libfuse.so.2")
    except OSError:
        return False
    return True


def installer_display_env():
    values = ["SKIP_PACKAGE_CHECK=1", "QT_QPA_PLATFORM=xcb"]
    for name in ("DISPLAY", "XAUTHORITY"):
        value = os.environ.get(name)
        if value:
            values.append(f"{name}={value}")
    return values


def installer_command(runfile):
    return sudo() + [
        "env",
        *installer_display_env(),
        str(runfile),
        "-i",
    ]


def root_display_is_authorized():
    result = out(["xhost"])
    if not result or result.returncode != 0:
        detail = ""
        if result:
            detail = (result.stderr or result.stdout).strip()
        die(
            "Could not access the X11/XWayland display with xhost. "
            + (detail or "Run this script from a terminal inside your desktop session.")
        )

    permissions = result.stdout.lower()
    return (
        "access control disabled" in permissions
        or "si:localuser:root" in permissions
        or "localuser:root" in permissions
        or "\nlocal:" in permissions
    )


def grant_root_display_access():
    if DRY:
        step("Would temporarily grant root access to the X11/XWayland display")
        run(["xhost", "+si:localuser:root"], check=False)
        return True
    if os.geteuid() == 0:
        die("Run this script as your regular desktop user, without sudo.")
    if not os.environ.get("DISPLAY"):
        die(
            "No X11/XWayland DISPLAY is available. Start the script from a "
            "terminal inside your graphical desktop session."
        )
    if not shutil.which("xhost"):
        die("xhost is required to open the graphical installer as root.")
    if root_display_is_authorized():
        info("Root already has access to the X11/XWayland display.")
        return False

    step("Temporarily granting root access to the X11/XWayland display")
    result = run(["xhost", "+si:localuser:root"], check=False)
    if result.returncode != 0:
        die("Could not grant root access to the X11/XWayland display.")
    return True


def revoke_root_display_access():
    step("Revoking temporary root display access")
    result = run(["xhost", "-si:localuser:root"], check=False)
    if result.returncode != 0:
        warn("Could not revoke root display access; run: xhost -si:localuser:root")


def install_without_fuse(runfile):
    if DRY:
        target = Path(tempfile.gettempdir()) / ".davinci-resolve-appimage-extract"
        step(f"Would extract the AppImage into: {target}")
        run([str(runfile), "--appimage-extract"], cwd=target)
        run(installer_command(target / "squashfs-root" / "AppRun"))
        return

    with tempfile.TemporaryDirectory(
        prefix=".davinci-resolve-appimage-extract-"
    ) as temp_dir:
        target = Path(temp_dir)
        step(f"Extracting the AppImage into: {target}")
        run([str(runfile), "--appimage-extract"], cwd=target)

        app_run = target / "squashfs-root" / "AppRun"
        if not app_run.is_file():
            die("AppImage extraction finished without creating squashfs-root/AppRun.")

        app_run.chmod(app_run.stat().st_mode | stat.S_IXUSR)
        run(installer_command(app_run))


def install_resolve(runfile, no_fuse=False):
    section(f"Installing {product_name(runfile.name)}")
    extract_and_run = no_fuse or not fuse2_ready()
    if extract_and_run:
        warn("FUSE 2 is unavailable or bypassed; using AppImage extract-and-run.")
    else:
        info("FUSE 2 runtime: ready")

    action = "Would run" if DRY else "Running"
    step(f"{action} the official installer with SKIP_PACKAGE_CHECK=1")
    display_granted = grant_root_display_access()
    try:
        if extract_and_run:
            install_without_fuse(runfile)
        else:
            run(installer_command(runfile))
    finally:
        if display_granted:
            revoke_root_display_access()
    ok("Installation previewed." if DRY else "Installer finished.")


def fix_old_libs():
    section("Bundled glib compatibility")
    libs = Path("/opt/resolve/libs")
    if not libs.exists():
        warn("/opt/resolve/libs does not exist; skipping the compatibility fix.")
        return

    files = []
    for pattern in LIB_PATTERNS:
        files.extend(libs.glob(pattern))

    files = sorted(set(p for p in files if p.is_file() or p.is_symlink()))

    if not files:
        ok("No incompatible bundled glib libraries found.")
        return

    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = libs / f"disabled-by-auto-installer-{stamp}"

    run(sudo() + ["mkdir", "-p", str(backup)])

    for f in files:
        run(sudo() + ["mv", "-n", str(f), str(backup) + "/"])

    action = "would be moved" if DRY else "moved"
    ok(f"{len(files)} library file(s) {action} to: {backup.name}")


def trash_cmd():
    if shutil.which("gio"):
        return ["gio", "trash"]
    if shutil.which("trash-put"):
        return ["trash-put"]
    if shutil.which("trash"):
        return ["trash"]
    return None


def cleanup_downloads(search_dirs):
    section("Cleanup → Trash")
    tcmd = trash_cmd()
    if not tcmd:
        warn("Neither gio nor trash-put is available; no downloads were moved.")
        info("Install trash-cli, or remove the Resolve downloads manually.")
        return

    targets = []
    seen = set()
    for d in search_dirs:
        d = Path(d).expanduser().resolve()
        if not d.exists():
            continue
        for p in d.rglob("*"):
            if is_extract_path(p):
                continue
            if p.is_file() and is_resolve(p.name) and p.suffix.lower() in (".zip", ".run"):
                if p not in seen:
                    seen.add(p)
                    targets.append(p)
        for p in d.rglob("*"):
            if p.is_dir() and is_extract_name(p.name) and p not in seen:
                seen.add(p)
                targets.append(p)

    if not targets:
        ok("Nothing to clean up.")
        return

    for p in targets:
        step(f"Moving to Trash: {paint(p.name, C.WHITE)}")
        run(tcmd + [str(p)], check=False)
    action = "would be sent" if DRY else "sent"
    ok(f"{len(targets)} item(s) {action} to Trash.")


def gpu_check():
    section("GPU / OpenCL")

    if shutil.which("nvidia-smi"):
        r = out([
            "nvidia-smi",
            "--query-gpu=name,driver_version",
            "--format=csv,noheader",
        ])
        if r and r.returncode == 0 and r.stdout.strip():
            for line in r.stdout.splitlines():
                info(f"NVIDIA: {line.strip()}")
        else:
            warn("nvidia-smi could not query the GPU.")
    else:
        warn("nvidia-smi not found. This is expected on AMD/Intel systems.")

    if shutil.which("clinfo"):
        try:
            r = subprocess.run(
                ["clinfo"],
                capture_output=True,
                text=True,
                timeout=12,
                check=False,
            )
            lines = list(dict.fromkeys(
                l for l in r.stdout.splitlines()
                if "Platform Name" in l or "Device Name" in l
            ))[:20]
            if lines:
                for l in lines:
                    info(l.strip())
            else:
                warn("clinfo found no visible platform or device.")
        except subprocess.TimeoutExpired:
            warn("clinfo timed out.")
    else:
        warn("clinfo not found.")


def main():
    global COLOR, DRY

    parser = argparse.ArgumentParser(
        description="Install DaVinci Resolve or DaVinci Resolve Studio on Linux."
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would happen without changing files.",
    )
    parser.add_argument("--skip-deps", action="store_true",
                        help="Do not check or install system dependencies.")
    parser.add_argument("--skip-install", action="store_true",
                        help="Prepare the installer without running it.")
    parser.add_argument("--skip-lib-fix", action="store_true",
                        help="Do not back up incompatible bundled glib libraries.")
    parser.add_argument("--no-clean", action="store_true",
                        help="Do not move Resolve downloads to Trash.")
    parser.add_argument(
        "--no-fuse",
        action="store_true",
        help="Run the AppImage through its extraction fallback instead of FUSE.",
    )
    parser.add_argument(
        "--search",
        action="append",
        help="Directory to search. May be specified more than once.",
    )
    parser.add_argument(
        "--color",
        choices=("auto", "always", "never"),
        default="auto",
        help="Control colored output (default: auto).",
    )

    args = parser.parse_args()
    DRY = args.dry_run
    COLOR = _color_on(args.color)

    search_dirs = args.search or ["~/Downloads"]
    banner(search_dirs)

    if not args.skip_deps:
        report_deps()

    build = find_latest_build(search_dirs)
    runfile = get_runfile(build)

    if not args.skip_install:
        install_resolve(runfile, no_fuse=args.no_fuse)

    if not args.skip_lib_fix:
        fix_old_libs()

    if not args.no_clean and not args.skip_install:
        cleanup_downloads(search_dirs)
    elif args.no_clean:
        info("Cleanup skipped (--no-clean).")

    gpu_check()

    if DRY:
        result = "Preview complete — no files changed."
    elif args.skip_install:
        result = f"Installer prepared: {runfile}"
    else:
        result = "DONE · launch with /opt/resolve/bin/resolve"
    success_box(result)


if __name__ == "__main__":
    main()
